<%# herb:slots server %>
<%# herb:state (step: 0, junction: 0, cycle: 40, split: 50, slowdown: 15, seed: 1, playing: false) %>
<%# Simulation inputs are read through helpers, which the client cannot evaluate, so changing them asks the server to re-run the simulation %>
<% content_for :title, @network.name %>
<% graph = @simulation.graph %>
<% junctions = graph.nodes.values.select(&:signalized) %>
<% junction_nodes = graph.nodes.values.reject { |node| graph.dead_end?(node.id) }.sort_by { |node| [ node.y, node.x ] } %>
<% selected = selected_junction(junction_nodes, junction) %>
<% dead_ends = graph.entries.map { |link| graph.nodes.fetch(link.from) }.sort_by { |node| [ node.x, node.y ] } %>

<main class="traffic" data-controller="autoplay">
  <header class="traffic__header">
    <h1><%= @network.name %></h1>
    <nav class="network-tabs" aria-label="道路網">
      <% @networks.each do |network| %>
        <%= link_to network.name, network_path(network), aria: { current: ("page" if network == @network) } %>
      <% end %>
    </nav>
  </header>

  <section class="traffic__controls">
    <div class="traffic__buttons">
      <button type="button" data-herb-toggle="playing"><% if playing %>停止<% else %>再生<% end %></button>
      <button type="button" data-herb-increment="step">1ステップ</button>
      <button type="button" data-herb-reset="step">リセット</button>
      <button type="button" data-herb-increment="seed">別の乱数</button>
    </div>

    <label class="traffic__slider">
      <span>信号サイクル <output><%= number_with_delimiter(cycle) %> ステップ</output></span> <%# herb:disable herb-state-valid-reads %>
      <input type="range" min="12" max="120" step="2" value="<%= cycle %>" autocomplete="off" data-herb-set="cycle=$value">
    </label>

    <label class="traffic__slider">
      <span>東西の青の割合 <output><%= number_to_percentage(split, precision: 0) %></output></span> <%# herb:disable herb-state-valid-reads %>
      <input type="range" min="10" max="90" step="5" value="<%= split %>" autocomplete="off" data-herb-set="split=$value">
    </label>

    <label class="traffic__slider">
      <span>ランダム減速 <output><%= number_to_percentage(slowdown, precision: 0) %></output></span> <%# herb:disable herb-state-valid-reads %>
      <input type="range" min="0" max="50" step="1" value="<%= slowdown %>" autocomplete="off" data-herb-set="slowdown=$value">
    </label>
  </section>

  <section class="traffic__stats">
    <dl>
      <div><dt>ステップ</dt><dd><%= number_with_delimiter(step) %></dd></div> <%# herb:disable herb-state-valid-reads %>
      <div><dt>走行中</dt><dd><%= @simulation.cars.size %> 台</dd></div>
      <div><dt>平均速度</dt><dd><%= number_with_precision(@simulation.average_velocity, precision: 2) %> / 5</dd></div>
      <div><dt>流出（直近100ステップ）</dt><dd><%= @simulation.recent_exits %> 台</dd></div>
      <div><dt>累計 流入 / 流出</dt><dd><%= @simulation.total_spawned %> / <%= @simulation.total_exits %></dd></div>
      <div><dt>入口待ち</dt><dd><%= @simulation.total_waiting %> 台</dd></div>
      <div><dt>seed</dt><dd><%= number_with_delimiter(seed) %></dd></div> <%# herb:disable herb-state-valid-reads %>
    </dl>
  </section>

  <div class="traffic__views">
    <figure class="traffic__figure">
      <%# Cars are HTML, not SVG: the ReActionView client builds added rows from HTML (marcoroth/herb#2811) %>
      <div class="network__map" role="img" aria-label="<%= @network.name %>の現在の状態">
        <% roads(graph).each do |from, to| %>
          <div class="network__road" style="<%= road_style(from, to) %>"></div>
        <% end %>

        <% graph.nodes.each_value do |node| %>
          <% unless graph.dead_end?(node.id) %>
            <div class="network__junction" style="<%= point_style(node.x, node.y) %>"></div>
          <% end %>
        <% end %>

        <% graph.links.each_value do |link| %>
          <% if graph.nodes.fetch(link.to).signalized %>
            <%# herb:key link.id %>
            <% x, y = signal_point(graph, link) %>
            <span class="network__signal <%= light_class(@simulation.light(link)) %>" style="<%= point_style(x, y) %>"></span>
          <% end %>
        <% end %>

        <% @simulation.cars.each do |car| %>
          <%# herb:key car.id %>
          <% x, y = car_point(@simulation, car) %>
          <span class="network__car <%= "is-waiting-right" if @simulation.waiting_to_turn_right?(car) %>" style="<%= point_style(x, y) %>; background: <%= velocity_color(car.velocity, 5) %>"></span>
        <% end %>
      </div>
      <figcaption>色 = 速度（赤ほど遅い）。枠付き = 右折待ち。交差点手前の点が信号</figcaption>
    </figure>

    <div class="network__panels">
      <figure class="traffic__figure">
        <table class="intersection__lanes network__ends">
          <thead>
            <tr><th scope="col">道路の端</th><th scope="col">流入（台/100ステップ）</th><th scope="col">流入</th><th scope="col">流出</th><th scope="col">入口待ち</th></tr>
          </thead>
          <tbody>
            <% dead_ends.each do |node| %>
              <%# herb:key node.id %>
              <tr data-controller="autosave" data-autosave-url-value="<%= node_path(node.id) %>" data-autosave-param-value="node[inflow]">
                <th scope="row"><%= dead_end_label(node) %></th>
                <td>
                  <label class="network__inflow">
                    <input type="range" min="0" max="100" step="1" value="<%= node.inflow %>" autocomplete="off" aria-label="<%= dead_end_label(node) %>の流入" data-action="input->autosave#preview change->autosave#save">
                    <output data-autosave-target="output"><%= node.inflow %></output>
                  </label>
                </td>
                <td><%= @simulation.entered_at(node.id) %></td>
                <td><%= @simulation.left_at(node.id) %></td>
                <td><%= @simulation.waiting_at(node.id) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <figcaption>流入は保存される（スライダーを離したとき）。入口待ち = 入口が詰まっていて道路に入れず、外で待っている台数</figcaption>
      </figure>

      <% if selected %>
        <figure class="traffic__figure">
          <div class="network-tabs" role="group" aria-label="交差点を選ぶ">
            <% junction_nodes.each do |node| %>
              <%# herb:key node.id %>
              <button type="button" data-herb-set="junction=<%= node.id %>" aria-pressed="<%= node == selected %>"><%= junction_label(node) %></button>
            <% end %>
          </div>
          <table class="intersection__lanes network__turns">
            <caption>交差点 <%= junction_label(selected_junction(junction_nodes, junction)) %> の進行方向</caption> <%# herb:disable herb-state-valid-reads %>
            <thead>
              <tr><th scope="col">進入方向</th><% Link::TURNS.each do |turn| %><th scope="col"><%= NetworksHelper::TURN_LABELS[turn] %></th><% end %></tr>
            </thead>
            <tbody>
              <% graph.incoming(selected.id).sort_by { |link| NetworksHelper::APPROACHES.index(approach_label(graph, link)) }.each do |link| %>
                <%# herb:key link.id %>
                <% offered = offered_turns(graph, link) %>
                <tr>
                  <th scope="row"><%= approach_label(graph, link) %></th>
                  <% Link::TURNS.each do |turn| %>
                    <%# herb:key turn %>
                    <td>
                      <% if offered.include?(turn) %>
                        <label class="network__weight" data-controller="autosave" data-autosave-url-value="<%= link_path(link.id) %>" data-autosave-param-value="link[<%= turn %>_weight]">
                          <input type="range" min="0" max="100" step="1" value="<%= link.turn_weights[turn] %>" autocomplete="off" aria-label="<%= approach_label(graph, link) %>の<%= NetworksHelper::TURN_LABELS[turn] %>の重み" data-action="change->autosave#save">
                          <span>設定 <%= turn_share(link, turn, offered) %>% / 実績 <%= actual_share(@simulation, link, turn) || "—" %>%</span>
                        </label>
                      <% else %>
                        <span class="network__muted">—</span>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
          <figcaption>重み（0〜100）は、その交差点で実際に行ける方向だけで割り振る。スライダーを離すと保存される。実績 = これまでにその方向へ進んだ割合</figcaption>
        </figure>
      <% end %>

      <figure class="traffic__figure">
        <% if junctions.any? %>
          <table class="intersection__lanes">
            <thead>
              <tr><th scope="col">信号交差点</th><th scope="col">東西</th><th scope="col">南北</th><th scope="col">待ち台数</th><th scope="col">右折待ち</th></tr>
            </thead>
            <tbody>
              <% junctions.each do |node| %>
                <%# herb:key node.id %>
                <% phase = @simulation.signal.phase(@simulation.time) %>
                <tr>
                  <th scope="row">(<%= node.x %>, <%= node.y %>)</th>
                  <td><span class="intersection__badge <%= light_class(phase.horizontal) %>"><%= IntersectionsHelper::LIGHT_LABELS[phase.horizontal] %></span></td>
                  <td><span class="intersection__badge <%= light_class(phase.vertical) %>"><%= IntersectionsHelper::LIGHT_LABELS[phase.vertical] %></span></td>
                  <td><%= graph.incoming(node.id).sum { |link| @simulation.queue_length(link.id) } %> 台</td>
                  <td><%= graph.incoming(node.id).sum { |link| @simulation.waiting_to_turn_right(link.id) } %> 台</td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <figcaption>待ち台数 = 交差点に向かう車線で止まっている台数。右折待ち = 対向車が途切れるのを停止線で待っている台数。全交差点が同じタイミングで切り替わる</figcaption>
        <% else %>
          <p class="network__note">信号のない道路網。右折車は対向車が途切れるのを待つ。同じ車線に入ろうとする車は、左折・直進・右折の順に1台ずつ進む。</p>
        <% end %>
      </figure>
    </div>
  </div>
</main>
